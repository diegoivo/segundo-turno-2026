{
  "name": "segundo-turno-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Front estatico do site da apuracao do 2o turno 2026 (SSG + JS vanilla)",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test --experimental-test-coverage --test-coverage-include='src/lib/**' --test-coverage-lines=80 test/unit/*.test.mjs",
